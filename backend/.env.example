# Standalone（默认）
POWERX_PROXY=0
IAMMode=local
POWERX_RUNTIME_WSBUS_DRIVER=auto
POWERX_RUNTIME_TASKBUS_DRIVER=auto
POWERX_RUNTIME_EVENT_TOPIC_DRIVER=auto
POWERX_RUNTIME_CACHE_DRIVER=auto
PLUGIN_IAM_TENANT_KEY=00000000-0000-0000-0000-000000000001
PLUGIN_IAM_TENANT_NAME="Local Tenant"
PLUGIN_IAM_ADMIN_EMAIL=admin@local.test
PLUGIN_IAM_ADMIN_PASSWORD='S3cret!!'
NUXT_PUBLIC_BRIDGE_DEBUG=false

# 005-channel-code-acquisition（渠道码引流与欢迎语发布）
LEAD_CAPTURE_CHANNEL_CODE_ENABLED=true
LEAD_CAPTURE_CHANNEL_CODE_EVENT_WEBHOOK_ENABLED=true
LEAD_CAPTURE_WELCOME_SYNC_ENABLED=true
LEAD_CAPTURE_WELCOME_SYNC_AUTO_PUBLISH_ON_SAVE=false
LEAD_CAPTURE_WELCOME_SYNC_RETRY_BACKOFF_SECONDS=5,15,30
LEAD_CAPTURE_WELCOME_SYNC_MAX_RETRIES=3

# Gateway 能力调用（供 Capability Lab / 前端调试使用）
# 默认直连 PowerX Dev API（可按需改为其它环境），TOKEN 请替换为自己账户，
# 若暂时没有凭证，可把 PX_USE_MOCK=media 之类的值写入以便返回 Mock 数据。
PX_GATEWAY_BASE_URL=http://127.0.0.1:8077
PX_GATEWAY_API_PREFIX=/api/v1
PX_GATEWAY_AUTH_SCHEME=bearer
PX_TOOL_TOKEN=replace-me-with-tool-token
PX_GATEWAY_API_KEY=
PX_GATEWAY_TIMEOUT=60s
PX_TOOL_REFRESH_TOKEN=replace-me-with-refresh-token
# PX_USE_MOCK=

# 模拟宿主/委派 IAM（按需启用）
# POWERX_PROXY=1
# IAMMode=delegated
# POWERX_CORE_ENDPOINT=http://localhost:8090
# POWERX_SECURITY_JWT_ISSUER=powerx-auth
# POWERX_SECURITY_JWT_AUDIENCE=plugin:com.powerx.plugins.scrm
