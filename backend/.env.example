# Standalone（默认）
POWERX_PROXY=0
IAMMode=local
POWERX_RBAC_DELEGATE=false
PLUGIN_IAM_TENANT_KEY=00000000-0000-0000-0000-000000000001
PLUGIN_IAM_TENANT_NAME="Local Tenant"
PLUGIN_IAM_ADMIN_EMAIL=admin@local.test
PLUGIN_IAM_ADMIN_PASSWORD='S3cret!!'
NUXT_PUBLIC_BRIDGE_DEBUG=false

# Gateway 能力调用（供 Capability Lab / 前端调试使用）
# 默认直连 PowerX Dev API（可按需改为其它环境），TOKEN/租户 UUID 请替换为自己账户，
# 若暂时没有凭证，可把 PX_USE_MOCK=media 之类的值写入以便返回 Mock 数据。
PX_GATEWAY_BASE_URL=http://127.0.0.1:8077
PX_TOOL_TOKEN=replace-me-with-tool-token
PX_TOOL_REFRESH_TOKEN=replace-me-with-refresh-token
PX_TENANT_UUID=00000000-0000-0000-0000-000000000001
# PX_USE_MOCK=

# 模拟宿主/委派 IAM（按需启用）
# POWERX_PROXY=1
# POWERX_RBAC_DELEGATE=true
# POWERX_CORE_ENDPOINT=http://localhost:8090
# POWERX_SECURITY_JWT_ISSUER=powerx-auth
# POWERX_SECURITY_JWT_AUDIENCE=plugin:com.powerx.plugin.base
